NODE_ENV=development
PORT=4000

# PostgreSQL bağlantısı (Coolify'da otomatik oluşturulan servis URL'i buraya girilir)
DATABASE_URL=postgres://isg_user:CHANGE_ME@localhost:5432/isg_takip

# En az 32 karakterlik rastgele bir değer kullanın: `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET

# Frontend adresi (virgülle birden fazla belirtilebilir)
CORS_ORIGIN=https://isg.shnai.cloud

# İlk kurulum sırasında oluşturulacak sistem admini (npm run db:seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=DegistirilmesiGerekenSifre123!

# Cloudflare R2 (fotograf depolama, S3 uyumlu nesne depolama)
R2_ACCOUNT_ID=CHANGE_ME_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=isg-takip-fotograflar

# Push bildirimleri (Web Push / VAPID) - opsiyonel: bos birakilirsa push bildirimleri devre
# disi kalir, uygulama ici bildirimler yine calisir. `node -e "console.log(require('web-push').generateVAPIDKeys())"`
# ile kendi anahtarinizi uretebilirsiniz.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@isg.shnai.cloud
